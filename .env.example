# Copy this to .env and adjust as needed.

# Host where Ollama is reachable. Use http://ollama:11434 in Docker Compose,
# http://localhost:11434 when running the backend natively.
OLLAMA_HOST=http://localhost:11434

# Model to use by default. Must already be pulled: `ollama pull <name>`.
# See README for hardware-based recommendations.
MODEL_NAME=qwen2.5-coder:7b-instruct-q4_K_M

MAX_CODE_CHARS=20000
REQUEST_TIMEOUT_SECONDS=300
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── OpenRouter (optional) ────────────────────────────────────────
# Get a free API key at: https://openrouter.ai/keys
# (free to create — no credit card needed)
#
# Five free coding models are pre-wired and ready the moment you
# add a key here — no other config needed:
#   • Qwen 2.5 Coder 32B (free)    — default
#   • Mistral 7B (free)
#   • Cohere North Mini Code (free)
#   • Nemotron 3 Ultra (free)
#   • Auto (any free model)
#
# All five cost $0 to use.  Leave blank to disable OpenRouter.
OPENROUTER_API_KEY=
